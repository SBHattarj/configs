#!/bin/bash

killall swaybg
if [ -z "$XDG_RUNTIME_DIR" ]; then
    export XDG_RUNTIME_DIR="$(find /run/user/* -maxdepth 1 -print -quit)"
fi
wallpaper_dir=$HOME/wallpaper
if [ -z "$WAYLAND_DISPLAY" ]; then
    displays="$(ls $XDG_RUNTIME_DIR | grep "wayland-[0-9]$")"
    for display in $displays; do
        WAYLAND_DISPLAY=$display swaybg -i $(find -H $wallpaper_dir -maxdepth 1 -type f -not -path "*/.*" | shuf -n 1) -m fill &
    done
else
    swaybg -i $(find -H $wallpaper_dir -maxdepth 1 -type f -not -path "*/.*" | shuf -n 1) -m fill &
fi
