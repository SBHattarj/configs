#!/usr/bin/env python
import contextlib
from functools import partial
import uinput
import time
from pathlib import Path

from dataclasses import dataclass, field
import asyncio
from pathlib import Path
import os
import sys
import socket
HOME=Path.home()
socket_path=HOME/".mouse"

SPEED = 20
SCROLL_SPEED = 1

@contextlib.contextmanager
def get_mouse_keyboard():
    with uinput.Device([
        uinput.REL_X,
        uinput.REL_Y,
        uinput.BTN_LEFT,
        uinput.BTN_RIGHT,
        uinput.BTN_MIDDLE,
        uinput.REL_WHEEL,
        uinput.REL_HWHEEL
    ]) as mouse:
        with uinput.Device([
            uinput.KEY_LEFTSHIFT,
            uinput.KEY_UP,
            uinput.KEY_DOWN,
            uinput.KEY_LEFT,
            uinput.KEY_RIGHT,
            uinput.KEY_W,
            uinput.KEY_LEFTALT,
            uinput.KEY_1,
            uinput.KEY_2,
            uinput.KEY_3,
            uinput.KEY_4,
            uinput.KEY_5,
            uinput.KEY_6,
            uinput.KEY_7,
            uinput.KEY_8,
            uinput.KEY_9,
            uinput.KEY_0
        ]) as keyboard:
            yield mouse, keyboard

async def mouse_usage(mouse_server: MouseServer):
    with get_mouse_keyboard() as (mouse, keyboard):
        await mouse_usage_main(mouse_server, mouse, keyboard)

async def mouse_usage_main(mouse_server: MouseServer, mouse: uinput.Device, keyboard: uinput.Device):
    dragging = False
    while True:
        command = await mouse_server.get_command()
        if command == "up":
            mouse.emit(uinput.REL_Y, -SPEED, syn=True)
            continue
        if command == "down":
            mouse.emit(uinput.REL_Y, SPEED, syn=True)
            continue
        if command == "left":
            mouse.emit(uinput.REL_X, -SPEED, syn=True)
            continue
        if command == "right":
            mouse.emit(uinput.REL_X, SPEED, syn=True)
            continue
        if command == "scroll-up":
            mouse.emit(uinput.REL_WHEEL, SCROLL_SPEED, syn=True)
            continue
        if command == "scroll-down":
            mouse.emit(uinput.REL_WHEEL, -SCROLL_SPEED, syn=True)
            continue
        if command == "scroll-left":
            mouse.emit(uinput.REL_HWHEEL, -SCROLL_SPEED, syn=True)
            continue
        if command == "scroll-right":
            mouse.emit(uinput.REL_HWHEEL, SCROLL_SPEED, syn=True)
            continue
        if command == "middle-click":
            mouse.emit(uinput.BTN_MIDDLE, 1, syn=True)
            await asyncio.sleep(0.05)
            mouse.emit(uinput.BTN_MIDDLE, 0, syn=True)
            continue
        if command == "click":
            mouse.emit(uinput.BTN_LEFT, 1, syn=True)
            await asyncio.sleep(0.05)
            mouse.emit(uinput.BTN_LEFT, 0, syn=True)
            continue
        if command == "right-click":
            mouse.emit(uinput.BTN_RIGHT, 1, syn=True)
            await asyncio.sleep(0.05)
            mouse.emit(uinput.BTN_RIGHT, 0, syn=True)
            continue
        if command == "left-key":
            keyboard.emit_click(uinput.KEY_LEFT, syn=True)
            continue
        if command == "right-key":
            keyboard.emit_click(uinput.KEY_RIGHT, syn=True)
            continue
        if command == "up-key":
            keyboard.emit_click(uinput.KEY_UP, syn=True)
            continue
        if command == "down-key":
            keyboard.emit_click(uinput.KEY_DOWN, syn=True)
            continue
        if command == "w":
            keyboard.emit_click(uinput.KEY_W, syn=True)
            continue
        if command == "alt-0":
            keyboard.emit_combo((uinput.KEY_LEFTALT, uinput.KEY_0), syn=True)
            continue
        if command == "alt-1":
            keyboard.emit_combo((uinput.KEY_LEFTALT, uinput.KEY_1), syn=True)
            continue
        if command == "alt-2":
            keyboard.emit_combo((uinput.KEY_LEFTALT, uinput.KEY_2), syn=True)
            continue
        if command == "alt-3":
            keyboard.emit_combo((uinput.KEY_LEFTALT, uinput.KEY_3), syn=True)
            continue
        if command == "alt-4":
            keyboard.emit_combo((uinput.KEY_LEFTALT, uinput.KEY_4), syn=True)
            continue
        if command == "alt-5":
            keyboard.emit_combo((uinput.KEY_LEFTALT, uinput.KEY_5), syn=True)
            continue
        if command == "alt-6":
            keyboard.emit_combo((uinput.KEY_LEFTALT, uinput.KEY_6), syn=True)
            continue
        if command == "alt-7":
            keyboard.emit_combo((uinput.KEY_LEFTALT, uinput.KEY_7), syn=True)
            continue
        if command == "alt-8":
            keyboard.emit_combo((uinput.KEY_LEFTALT, uinput.KEY_8), syn=True)
            continue
        if command == "alt-9":
            keyboard.emit_combo((uinput.KEY_LEFTALT, uinput.KEY_9), syn=True)
            continue
        if command == "drag-start" and not dragging:
            dragging=True
            mouse.emit(uinput.BTN_LEFT, 1, syn=True)
            mouse.emit(uinput.REL_X, 0, syn=True)
            continue
        if command == "drag-end" and dragging:
            mouse.emit(uinput.BTN_LEFT, 0, syn=True)
            dragging=False
            continue
        if command == "exit":
            loop = asyncio.get_running_loop()
            loop.call_soon_threadsafe(loop.stop)
            sys.exit(0)

@dataclass(slots=True)
class MouseServer:
    __command_queue: asyncio.Queue = field(default_factory=asyncio.Queue, init=False)


    async def get_command(self) -> str:
        return await self.__command_queue.get()

    def send(self, message: str):
        self.__command_queue.put_nowait(message)

    def __post_init__(self):
        asyncio.create_task(mouse_usage(self))


@dataclass(slots=True)
class MouseServerProtocol(asyncio.Protocol):
    mouse_server: MouseServer
    transport: asyncio.BaseTransport | None = None
    def connection_made(self, transport):
        self.transport = transport

    def data_received(self, data):
        self.mouse_server.send(data.decode())
        if self.transport == None: return
        self.transport.close()

def get_argument() -> str:
    if len(sys.argv) < 2: return ""
    return sys.argv[1]

def empty_dir(path: Path):
    if path == HOME: return
    if not path.is_relative_to(HOME): return

    for root, dirs, files in path.walk(top_down=False):
        for name in files:
            (root/name).unlink()
        for name in dirs:
            (root/name).rmdir()

def remove_path(path: Path):
    if path.is_dir():
        empty_dir(path)
        path.rmdir()
        return
    path.unlink()

async def try_connection(loop: asyncio.AbstractEventLoop) -> bool:
    if not socket_path.exists():
        return False
    try:
        argument = get_argument()
        (transport, _) = await loop.create_unix_connection(asyncio.Protocol, path=str(socket_path))
        if argument != "":
            transport.write(argument.encode())
        return True
    except ConnectionRefusedError:
        remove_path(socket_path)
        return False

async def first_connection(loop: asyncio.AbstractEventLoop):
    await asyncio.sleep(0.05)
    await try_connection(loop)

async def main():
    loop = asyncio.get_running_loop()
    was_client = await try_connection(loop)
    if was_client: return
    mouse_server=MouseServer()
    server = await loop.create_unix_server(partial(MouseServerProtocol, mouse_server), path=socket_path, cleanup_socket=True)
    asyncio.create_task(first_connection(loop))
    async with server:
        await server.serve_forever()

if __name__ == "__main__":
    asyncio.run(main())
