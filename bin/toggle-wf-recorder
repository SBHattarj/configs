#!/bin/zsh


pid=`pgrep wf-recorder`
status_=$(ps -A | grep "wf-recorder")
index=0
if [[ -z $status_ ]];
then
    str="$(wf-recorder -L)"
    array=(${(f)str})
    command_options=""
    if (( ${#array[@]} <= 1 )); then
        echo "hello"
        display=${array[0]}
        geometry=$(slurp)
        if [[ $? -eq 1 ]]; then
            return
        fi
        wf-recorder -g "$geometry" -f "$HOME/recordings/$(date +'recording_%d-%m-%Y-%H%M%S.mp4')" -o $display
        return
    fi;
    for ((i=1; i<=${#array[@]}; i++));
    do
        line_arr=(${(s: :)array[$i]})
        command_options="$command_options${line_arr[3]}\n"
    done
    command=(${(f)command})
    display=$(echo -n $command_options | rofi -dmenu -p "Select dispalay")
    if [[ -z $display ]]; then
        return
    fi
    #e cho $display
    #temp="$(pactl list sources | grep Name | grep bluez_output)"
    #temp="${temp##*:}"
    #audio_device_name="${temp// /}"
    #echo $audio_device_name
    geometry=$(slurp)
    if [[ $? -eq 1 ]]; then
        return
    fi
    wf-recorder -g "$geometry" -f "$HOME/recordings/$(date +'recording_%d-%m-%Y-%H%M%S.mp4')" -o $display

else
    killall wf-recorder
fi;
