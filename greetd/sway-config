exec 'GTK_THEME=Adwaita:dark gtkgreet -s "/etc/greetd/gtkgreet.css"; swaymsg exit'
output * bg `find /etc/greetd/wallpaper -maxdepth 1 -type f | shuf -n 1` fill

for_window [app_id="gtkgreet"] border none

set $nag exec swaynagmode

bindsym Mod1+shift+e $nag \
-t warning \
-m 'What do you want to do?' \
-b 'Poweroff' 'systemctl poweroff' \
-b 'Reboot' 'systemctl reboot'


mode "nag" {
    bindsym {
        Ctrl+d mode "default"
        Ctrl+c $nag --exit
        Escape $nag --exit
        Return $nag --confirm
        j $nag --select prev
        k $nag --select next
    }
}

include /etc/sway/config.d/*
