exec 'GTK_THEME=Adwaita:dark gtkgreet -s "/etc/greetd/gtkgreet.css"; swaymsg exit'
output * bg `find -H /etc/greetd/wallpaper -maxdepth 1 -type f -not -path \"*/.*\" | shuf -n 1 | shuf -n 1` fill

for_window [app_id="gtkgreet"] border none

set $exit exec zsh /etc/greetd/exit.sh

bindsym Mod1+shift+e $exit


bindsym Mod1+t exec contour

include /etc/sway/config.d/*
