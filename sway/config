# Variables
set $mod Mod1

# directions
set $left h
set $down j
set $up k
set $right l

# special applications
set $term contour tmux
set $browser brave
set $obs obs
set $scrcpy scrcpy --stay-awake -S
set $chbgrnd ~/.local/bin/chbgrnd
set $virtoutinit ~/.local/bin/virtoutinit
set $vncout ~/.local/bin/vncout
set $wallpaper_dir ~/wallpaper
set $audio-controls pwvucontrol
set $keyboard-sound killall buckle; $HOME/.local/bin/buckle

## runner
set $menu rofi -show drun

# sway nag
set $nag exec swaynagmode

# control input
set $move_mouse_up ~/.local/bin/mouse up
set $move_mouse_down ~/.local/bin/mouse down
set $move_mouse_left ~/.local/bin/mouse left
set $move_mouse_right ~/.local/bin/mouse right
set $drag_start ~/.local/bin/mouse drag-start
set $drag_end ~/.local/bin/mouse drag-end
set $scroll_mouse_up ~/.local/bin/mouse scroll-up
set $scroll_mouse_down ~/.local/bin/mouse scroll-down
set $scroll_mouse_left ~/.local/bin/mouse scroll-left
set $scroll_mouse_right ~/.local/bin/mouse scroll-right
set $mouse_click ~/.local/bin/mouse click
set $mouse_right_click ~/.local/bin/mouse right-click
set $mouse_middle_click ~/.local/bin/mouse middle-click
set $key_up ~/.local/bin/mouse up-key
set $key_down ~/.local/bin/mouse down-key
set $key_right ~/.local/bin/mouse right-key
set $key_left ~/.local/bin/mouse left-key


# virtual outputs
output HEADLESS-1 {
    mode 2048x1100
}
output HEADLESS-2 {
    pos 0,0
    mode 1920x940
    transform 90
}

# bar configuration
bar {
    position top
    swaybar_command waybar

}

# Basic Setup
default_border pixel 4
gaps inner 4
gaps outer 4
smart_borders on
default_floating_border pixel 8
output * bg `find -H $wallpaper_dir -maxdepth 1 -type f -not -path \"*/.*\" | shuf -n 1` fill
floating_modifier $mod normal

# startup
exec swaync
exec "clipcascade --xmode false >> ~/.log"


bindsym {

    #show bluetooth side bar
    $mod+Shift+b exec bm-sidebar --toggle

    # notification side bar
    $mod+Shift+n exec swaync-client -t -sw

    # changing background
    $mod+Shift+g exec $HOME/.local/bin/chbgrnd

    # add virtual outputs
    $mod+Shift+v exec $virtoutinit

    # vnc for virtual outputs
    $mod+Shift+o exec $vncout 1
    $mod+Shift+i exec $vncout 2

    # screenshots and recordings
    $mod+Plus exec SWAY_SCREENSHOT_DIR=$HOME/screenshots/ sway-screenshot -m output
    $mod+Equal exec SWAY_SCREENSHOT_DIR=$HOME/screenshots/ sway-screenshot -m region
    $mod+Underscore exec SWAY_SCREENSHOT_DIR=$HOME/screenshots/ sway-screenshot -m window
    $mod+Shift+t exec $keyboard-sound
    $mod+Minus exec $HOME/.local/bin/toggle-wf-recorder &> recordings-failure >> recordings-output


    # audio controls
    XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
    XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

    # exit applications
    $mod+Shift+q kill

    # logout
    $mod+Shift+e $nag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'



    # reload config after changes
    $mod+Shift+c reload

    # application navigation
    $mod+$left focus left
    $mod+$down focus down
    $mod+$up focus up
    $mod+$right focus right

    $mod+Shift+$left move left
    $mod+Shift+$down move down
    $mod+Shift+$up move up
    $mod+Shift+$right move right

    $mod+shift+z splith
    $mod+shift+x splitv

    $mod+shift+s layout stacking
    $mod+shift+d layout tabbed
    $mod+e layout toggle split

    $mod+f fullscreen

    $mod+Shift+space floating toggle

    $mod+space focus mode_toggle

    $mod+period focus parent
    $mod+Comma focus child

    # mode switching
    $mod+r mode "run"
    $mod+Shift+r mode "resize"
    $mod+shift+m mode "mouse"
    $mod+w mode "workspaces"
}

#homerow arrow control

bindsym --to-code --no-repeat Ctrl+$up exec $key_up
bindsym --to-code --release Ctrl+Up+$up exec $key_up
bindsym --to-code --no-repeat ctrl+$down exec $key_down
bindsym --to-code --release Ctrl+Down+$down exec $key_down
bindsym --to-code --no-repeat Ctrl+$left exec $key_left
bindsym --to-code --release Ctrl+Left+$left exec $key_left
bindsym --to-code --no-repeat Ctrl+$right exec $key_right
bindsym --to-code --release Ctrl+Right+$right exec $key_right
#modes
mode "run" {
    bindsym {
        t exec $term; mode "default"
        b exec $browser; mode "default"

        s exec $obs; mode "default"

        p exec $scrcpy; mode "default"

        Shift+a exec $audio-control; mode "default"

        r exec $menu; mode "default"; mode "default"



        $mod+t exec $term; mode "default"; mode "default"


        $mod+b exec $browser; mode "default"

        $mod+s exec $obs; mode "default"

        $mod+p exec $scrcpy; mode "default"

        $mod+Shift+a exec $audio-controls; mode "default"

        $mod+r exec $menu; mode "default"


        Return mode "default"
        Escape mode "default"
    }
}

mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym {
        $left resize shrink width 10px
        $down resize grow height 10px
        $up resize shrink height 10px
        $right resize grow width 10px

        Left resize shrink width 10px
        Down resize grow height 10px
        Up resize shrink height 10px
        Right resize grow width 10px

        # Return to default mode
        Return mode "default"
        Escape mode "default"
    }
}


mode "nag" {
    bindsym {
        Ctrl+d mode "default"
        Ctrl+c $nag --exit
        Escape $nag --exit
        Return $nag --confirm
        j $nag --select next
        k $nag --select prev
    }
}

mode "mouse" {
    bindsym {
        $up exec $move_mouse_up
        $down exec $move_mouse_down
        $left exec $move_mouse_left
        $right exec $move_mouse_right
        a exec $mouse_click
        f exec $mouse_right_click
        s exec $mouse_middle_click
        Ctrl+Shift+d mode "mouse-drag"; exec $drag_start
        Ctrl+Shift+s mode "mouse-scroll"
        Escape mode "default"
    }
}

mode "mouse-scroll" {
    bindsym {
        $up exec $scroll_mouse_up
        $down exec $scroll_mouse_down
        $left exec $scroll_mouse_left
        $right exec $scroll_mouse_right
        a exec $mouse_click
        f exec $mouse_right_click
        s exec $mouse_middle_click
        Ctrl+Shift+s mode "mouse";
        Escape mode "mouse";
    }
}

mode "mouse-drag" {
    bindsym {
        $up exec $move_mouse_up
        $down exec $move_mouse_down
        $left exec $move_mouse_left
        $right exec $move_mouse_right
        a exec $mouse_click
        f exec $mouse_right_click
        s exec $mouse_middle_click
        Ctrl+Shift+d mode "mouse"; exec $drag_end
        Escape mode "mouse"; exec $drag_end
    }
}

mode "workspaces" {
    bindsym {
        # terminal
        t workspace number 1; mode "default"
        # browser
        b workspace number 2; mode "default"
        # discord
        d workspace number 3; mode "default"
        #runner/others
        r workspace number 4; mode "default"
        #testing/development
        e workspace number 5; mode "default"


        1 workspace number 1; mode "default"
        2 workspace number 2; mode "default"
        3 workspace number 3; mode "default"
        4 workspace number 4; mode "default"
        5 workspace number 5; mode "default"
        6 workspace number 6; mode "default"
        7 workspace number 7; mode "default"
        8 workspace number 8; mode "default"
        9 workspace number 9; mode "default"


        $left workspace prev; mode "default"
        $right workspace next; mode "default"


        Shift+t move container to workspace number 1; mode "default"
        Shift+b move container to workspace number 2; mode "default"
        Shift+d move container to workspace number 3; mode "default"
        Shift+r move container to workspace number 4; mode "default"
        Shift+e move container to workspace number 5; mode "default"


        Shift+1 move container to workspace number 1; mode "default"
        Shift+2 move container to workspace number 2; mode "default"
        Shift+3 move container to workspace number 3; mode "default"
        Shift+4 move container to workspace number 4; mode "default"
        Shift+5 move container to workspace number 5; mode "default"
        Shift+6 move container to workspace number 6; mode "default"
        Shift+7 move container to workspace number 7; mode "default"
        Shift+8 move container to workspace number 8; mode "default"
        Shift+9 move container to workspace number 9; mode "default"


        Shift+$left move container to workspace prev; mode "default"
        Shift+$right move container to workspace next; mode "default"
        Escape mode "default"
    }
}

include /etc/sway/config.d/*
